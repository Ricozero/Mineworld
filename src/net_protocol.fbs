namespace mineworld.net;

file_identifier "MWNP";
file_extension "mwnp";

struct Vec3 {
  x:float;
  y:float;
  z:float;
}

struct IVec3 {
  x:int;
  y:int;
  z:int;
}

table ClientHello {
}

table ClientDisconnect {
}

table ClientReady {
}

table ServerHello {
  session_id:uint;
  actor_id:ulong;
  actor_name:string;
  position:Vec3;
  yaw:float;
  pitch:float;
  player_mode:ubyte;
  core_chunks:[IVec3];
}

table ClientInput {
  position:Vec3;
  velocity:Vec3;
  yaw:float;
  pitch:float;
  player_mode:ubyte;
  sequence:uint;
}

table ActorState {
  id:ulong;
  name:string;
  position:Vec3;
  velocity:Vec3;
  yaw:float;
  pitch:float;
  entity_type:ubyte;
  player_mode:ubyte;
}

table EntitySnapshot {
  sequence:uint;
  actors:[ActorState];
}

table ChunkUpsert {
  chunk_pos:IVec3;
  revision:uint;
  compression:ubyte;
  uncompressed_size:uint;
  blocks:[ubyte];
}

struct ChunkUnload {
  chunk_pos:IVec3;
  revision:uint;
}

table ChunkUpsertBatch {
  chunks:[ChunkUpsert];
}

table ChunkUnloadBatch {
  chunks:[ChunkUnload];
}

table StringArgument {
  value:string;
}

table IntegerArgument {
  value:long;
}

table FloatArgument {
  value:double;
}

table BoolArgument {
  value:bool;
}

table Vec3Argument {
  value:Vec3;
}

union CommandArgumentValue {
  StringArgument,
  IntegerArgument,
  FloatArgument,
  BoolArgument,
  Vec3Argument
}

table CommandArgument {
  value:CommandArgumentValue;
}

table CommandRequest {
  request_id:ulong;
  operation:ushort;
  arguments:[CommandArgument];
}

table CommandResponse {
  request_id:ulong;
  success:bool;
  message:string;
}

table ChatRequest {
  text:string;
}

table ChatMessage {
  name:string;
  text:string;
}

union NetMessagePayload {
  ClientHello,
  ClientDisconnect,
  ClientReady,
  ServerHello,
  ClientInput,
  EntitySnapshot,
  ChunkUpsertBatch,
  ChunkUnloadBatch,
  CommandRequest,
  CommandResponse,
  ChatRequest,
  ChatMessage
}

table NetMessage {
  payload:NetMessagePayload;
}

root_type NetMessage;
