namespace mineworld.net;

file_identifier "MWNP";
file_extension "mwnp";

struct Vec3 {
  x:float;
  y:float;
  z:float;
}

struct IVec3 {
  x:int;
  y:int;
  z:int;
}

table ClientHello {
}

table ClientDisconnect {
}

table ClientReady {
}

table ServerHello {
  session_id:uint;
  actor_name:string;
  position:Vec3;
  yaw:float;
  pitch:float;
  player_mode:ubyte = 0;
  core_chunks:[IVec3];
}

table ClientInput {
  position:Vec3;
  velocity:Vec3;
  yaw:float;
  pitch:float;
  player_mode:ubyte = 0;
  sequence:uint = 0;
}

table ActorState {
  name:string;
  position:Vec3;
  velocity:Vec3;
  yaw:float;
  pitch:float;
  entity_type:ubyte = 0;
  player_mode:ubyte = 0;
}

enum ChunkOperation : ubyte {
  Upsert,
  Unload
}

table EntitySnapshot {
  sequence:uint;
  actors:[ActorState];
}

table ChunkUpdate {
  chunk_pos:IVec3;
  revision:uint;
  operation:ChunkOperation = Upsert;
  blocks:[ubyte];
}

union NetMessagePayload {
  ClientHello,
  ClientDisconnect,
  ClientReady,
  ServerHello,
  ClientInput,
  EntitySnapshot,
  ChunkUpdate
}

table NetMessage {
  payload:NetMessagePayload;
}

root_type NetMessage;
